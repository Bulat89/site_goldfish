# Сайт Goldfish: вход через Яндекс ID, расширение и личный кабинет владельца объекта.
# В App Platform Timeweb эти переменные задаются в панели приложения, на своём сервере —
# в файле .env (cp .env.example .env). Пустое значение = не задано.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Адрес сайта, как его открывают пользователи (https в продакшене). Из него строится
# Redirect URI для Яндекс ID: <PUBLIC_URL>/auth/yandex/callback
PUBLIC_URL=https://goldfish.example.ru

# PostgreSQL. В docker compose без неё используется база из того же compose; для управляемой
# базы Timeweb — её строка подключения. Без compose и без DATABASE_URL (только разработка)
# пользователи и сессии живут в памяти.
DATABASE_URL=
# Сколько дней действует вход на сайт.
SESSION_DAYS=30

# Приложение Яндекс ID (https://oauth.yandex.ru/client/new): ClientID и Client secret.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Сервер Goldfish, к которому подключается расширение. Пользователь его не видит и не вводит:
# адрес уходит в расширение внутри «ключа подключения», который выдаёт кабинет («Настройки»).
GOLDFISH_URL=https://agent.example.ru
# Откуда сайт ходит в API оператора, если не через GOLDFISH_URL (например, внутренний адрес).
GOLDFISH_ADMIN_URL=
# ADMIN_TOKEN сервера Goldfish. Даёт полный доступ к серверу — храните как пароль.
GOLDFISH_ADMIN_TOKEN=
# Клиент (компания) Goldfish, в котором живут пользователи сайта. Без GOLDFISH_CLIENT_ID сайт
# найдёт клиента по имени или создаст его.
GOLDFISH_CLIENT_ID=
GOLDFISH_CLIENT_NAME=Сайт
# Предупреждения и ошибки сайта уходят в журнал ошибок сервера Goldfish (читается через его MCP).
REPORT_ERRORS=true

# Сервер ботов в Telegram, MAX и WhatsApp (репозиторий tg_goldfish): в кабинете появятся QR-коды
# для привязки мессенджера. BOTS_API_TOKEN — тот же, что у сервера ботов. Без BOTS_URL остаётся
# Telegram-бот сервера Goldfish (если он настроен).
BOTS_URL=
BOTS_API_TOKEN=

# Свой zip расширения; без него сайт отдаёт пакет с GOLDFISH_URL/extension/download.
EXTENSION_ZIP=

# Ссылки в подвале (необязательно).
PRIVACY_URL=
SUPPORT_EMAIL=

# Caddy на своём сервере (docker compose -f docker-compose.yml -f deploy/caddy.yml up -d): домен.
SITE_DOMAIN=goldfish.example.ru
